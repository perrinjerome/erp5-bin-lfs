␀␀␀␀␀␀C␀␀␀s␀␀␀dd„␀|D␀ƒ}dd„␀t␀||ƒD␀ƒ}|ddgkr6tdƒ‚|\}}tj|␀|fddd␀\}␀}t|␀|ƒ}t||ƒ}|d␀|d	d
